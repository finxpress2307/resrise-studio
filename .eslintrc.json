{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "plugins": [
    "html"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "off",
    "no-empty": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".pytest_cache/**",
    "*.py",
    "*.bat",
    "*.md"
  ]
}
