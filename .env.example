# Resrise Studio - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# OpenRouter API (Primary LLM provider)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Anthropic-compatible endpoint (OpenRouter acts as Anthropic proxy)
ANTHROPIC_AUTH_TOKEN=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=inclusionai/ling-3.2-flash:free
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1

# Optional: Local LLM Fallbacks
# OmniRoute (local OpenAI-compatible gateway)
# OMNIROUTE_URL=http://localhost:20128/v1/chat/completions
# OMNIROUTE_MODEL=gemini/gemini-3-flash-preview
# OMNIROUTE_API_KEY=

# Google Gemini API (Direct vision & text fallback via official google-genai SDK)
# Supported models: gemini-4-hydrogen (Active), gemini-4-neon / gemini-4-carbon (Requires AI Studio Paid Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen

# Ollama (Local models)
# OLLAMA_URL=http://localhost:11434/api/chat
# OLLAMA_MODEL=gemma3:4b

# Instagram Accounts (managed via scripts/accounts_config.json)
# No env vars needed for account credentials - uses Chrome persistent profiles